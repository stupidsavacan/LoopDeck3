{
  "name": "loopdeck3",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:local": "vite",
    "build": "npm run typecheck && vite build",
    "build:single": "npm run typecheck && vite build --mode single && node scripts/make-single-html.mjs dist-single LoopDeck3.html",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "deadcode": "node scripts/check-dead-code.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:builtin": "vitest run tests/builtinData.test.ts",
    "test:resolver": "vitest run tests/packResolver.test.ts",
    "test:merger": "vitest run tests/packMerger.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "verify": "npm run check && npm run build",
    "qa:chrome": "npm run build:single && playwright test",
    "qa:chrome:report": "playwright show-report qa-report",
    "format": "node scripts/format-changed.mjs --write",
    "format:check": "node scripts/format-changed.mjs",
    "lint": "tsc --noEmit --noUnusedLocals --allowUnreachableCode false --noFallthroughCasesInSwitch",
    "code:map": "node scripts/code-map.mjs",
    "readability": "node scripts/source-guardrails.mjs report"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@pdf-lib/fontkit": "^1.1.1",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
